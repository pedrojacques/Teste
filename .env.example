# Copie para .env e preencha. Nunca versione o .env.

# Chave da API da Anthropic (usada a partir da Fase 3).
ANTHROPIC_API_KEY=
# Modelo usado nas análises e na geração.
ANTHROPIC_MODEL=claude-opus-5-5

# Pasta local de dados (banco SQLite e arquivos originais). Fora de diretórios servidos.
EDITALLAB_DIR_DADOS=dados

# Limites de upload.
EDITALLAB_MAX_TAMANHO_ARQUIVO_MB=50
EDITALLAB_ZIP_MAX_DESCOMPACTADO_MB=200
EDITALLAB_ZIP_MAX_ARQUIVOS=200

# OCR (Tesseract).
EDITALLAB_OCR_IDIOMA=por
EDITALLAB_OCR_LIMIAR_CARACTERES=20
